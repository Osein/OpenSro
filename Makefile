# nmake build for the static libraries and tests. Run toolchain\env.cmd first.
#
#   nmake            build all libraries and tests
#   nmake test       build and run the tests
#   nmake clean

# _SECURE_SCL_THROWS=1: the originals' checked iterators throw out_of_range / invalid_argument
# ("invalid vector<T> subscript") instead of calling _invalid_parameter.
CFLAGS  = /nologo /c /O2 /MT /EHsc /GS /W3 /Zi /DWIN32 /DNDEBUG /D_WINDOWS \
          /D_WIN32_WINNT=0x0500 /DWIN32_LEAN_AND_MEAN /D_SECURE_SCL_THROWS=1 \
          /IJMX_Library /IJMX_ServerFramework /IJMX_CommonServers
LIBFLAGS = /nologo
SYSLIBS = ws2_32.lib user32.lib ole32.lib iphlpapi.lib gdi32.lib comctl32.lib advapi32.lib \
          odbc32.lib

# The vSRO security tables are built in. nmake SECURITY_CONSTANTS=1 uses a table generated by
# tools\gen_security_constants.py instead.
!IFDEF SECURITY_CONSTANTS
CFLAGS = $(CFLAGS) /DBSNET_SECURITY_CONSTANTS
!ENDIF

# The publisher key of the GatewayServer certification queries, generated by
# tools\gen_certify_constants.py (not in the repository); without it the key is empty.
!IF EXIST(JMX_CommonServers\GatewayServer\CertifyConstants.inl)
CFLAGS = $(CFLAGS) /DGATEWAY_CERTIFY_CONSTANTS
!ENDIF

OUT = build
OBJ = $(OUT)\obj
LIBDIR = $(OUT)\lib
BIN = $(OUT)\bin

