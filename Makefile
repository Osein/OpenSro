	link /nologo /DEBUG /out:$@ $(OBJ)\test\ShardClimateTest.obj \
	    $(OBJ)\ShardManager\Climate.obj $(SHARD_REC_OBJS) $(SHARD_LIBS) $(SYSLIBS)

