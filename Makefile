                  ws2_32.lib shlwapi.lib ole32.lib gdi32.lib comctl32.lib

# DownloadServer application (JMX_CommonServers\DownloadServer), built by "nmake download". The
# framework files that name the module (service, semaphore and startup error name, the
# certification check, the Server.cfg block) are compiled again for it and linked before the
# libraries.
DOWNLOAD_OBJS = \
	$(OBJ)\DownloadServer\DownloadServer.obj \
	$(OBJ)\DownloadServer\DownloadServerMainProcess.obj
DOWNLOAD_FW_OBJS = \
	$(OBJ)\DownloadServer\fw\CertArch.obj \
	$(OBJ)\DownloadServer\fw\ServerApp.obj \
	$(OBJ)\DownloadServer\fw\ServerConfig.obj
DOWNLOAD_FW_DEFS = /DSERVER_MODULE_NAME=\"DownloadServer\" \
                   /DSERVER_CONFIG_MODULE_NAME=\"DownloadServer\"
DOWNLOAD_SYSLIBS = kernel32.lib advapi32.lib iphlpapi.lib user32.lib ws2_32.lib ole32.lib \
                   gdi32.lib comctl32.lib

# MachineManager application (JMX_CommonServers\MachineManager), built by "nmake machine". Like
# DownloadServer it gets its own build of the framework files that name the module; MachineManager
# also reaches the certification server through a keep-alive target.
MACHINE_OBJS = \
	$(OBJ)\MachineManager\MachineManager.obj \
	$(OBJ)\MachineManager\MachineManagerMainProcess.obj \
	$(OBJ)\MachineManager\PerfCounter.obj
MACHINE_FW_OBJS = \
	$(OBJ)\MachineManager\fw\CertArch.obj \
	$(OBJ)\MachineManager\fw\ServerApp.obj \
	$(OBJ)\MachineManager\fw\ServerConfig.obj
MACHINE_FW_DEFS = /DSERVER_MODULE_NAME=\"MachineManager\" \
                  /DSERVER_CONFIG_MODULE_NAME=\"MachineManager\" \
                  /DSERVER_CERTIFICATION_KEEP_ALIVE=1
MACHINE_SYSLIBS = kernel32.lib advapi32.lib iphlpapi.lib user32.lib ws2_32.lib ole32.lib \
                  gdi32.lib comctl32.lib pdh.lib

# FarmManager application (JMX_CommonServers\FarmManager), built by "nmake farm". FarmManager is
# built on the 2007 framework: the blocks under JMX_FRAMEWORK_2007 in the library sources (one of
# them changes the layout of CServerProcessMain and CServerArchitectureView). So that no object
# of the link mixes the two versions, the three libraries are built a second time from the same
# sources with FARM_DEFS into build\obj\farm and build\lib\farm (FARM_LIBS), and the FarmManager
# sources and its test are compiled with the same defines. The module name defines go to every
# farm framework file; only CertArch, ServerApp and ServerConfig use them.
FARM_OBJS = \
	$(OBJ)\FarmManager\FarmManager.obj \
	$(OBJ)\FarmManager\FarmManagerMainProcess.obj
FARM_DEFS = /DJMX_FRAMEWORK_2007 \
            /DSERVER_MODULE_NAME=\"FarmManager\" \
            /DSERVER_CONFIG_MODULE_NAME=\"FarmManager\"
FARM_SYSLIBS = $(DOWNLOAD_SYSLIBS)
FARM_OBJ = $(OBJ)\farm
FARM_LIBDIR = $(LIBDIR)\farm
FARM_BSLIB_OBJS = $(BSLIB_OBJS:build\obj\BSLib=build\obj\farm\BSLib)
FARM_BSNET_OBJS = $(BSNET_OBJS:build\obj\BSNet=build\obj\farm\BSNet)
FARM_SRVFW_OBJS = $(SRVFW_OBJS:build\obj\ServerFramework=build\obj\farm\ServerFramework)
FARM_LIBS = $(FARM_LIBDIR)\ServerFramework.lib $(FARM_LIBDIR)\BSNet.lib $(FARM_LIBDIR)\BSLib.lib

# The 2011 framework of AgentServer (JMX_ServerFramework\FRAMEWORK_2011.md): the blocks under
# JMX_FRAMEWORK_2011 in the library sources, several of which change class layouts. Like the farm
# build, the three libraries are built a second time from the same sources with AGENT_DEFS into
# build\obj\agent and build\lib\agent (AGENT_LIBS); everything linked with them is compiled with
# AGENT_DEFS too.
AGENT_DEFS = /DJMX_FRAMEWORK_2011 \
             /DSERVER_MODULE_NAME=\"AgentServer\" \
             /DSERVER_CONFIG_MODULE_NAME=\"AgentServer\"
AGENT_OBJ = $(OBJ)\agent
AGENT_LIBDIR = $(LIBDIR)\agent
AGENT_BSLIB_OBJS = $(BSLIB_OBJS:build\obj\BSLib=build\obj\agent\BSLib)
AGENT_BSNET_OBJS = $(BSNET_OBJS:build\obj\BSNet=build\obj\agent\BSNet)
AGENT_SRVFW_OBJS = $(SRVFW_OBJS:build\obj\ServerFramework=build\obj\agent\ServerFramework)
AGENT_LIBS = $(AGENT_LIBDIR)\ServerFramework.lib $(AGENT_LIBDIR)\BSNet.lib \
             $(AGENT_LIBDIR)\BSLib.lib

# The January 2011 framework of GlobalManager (JMX_ServerFramework\FRAMEWORK_2011.md, "January 2011
# (GlobalManager)"): the July 2011 framework (JMX_FRAMEWORK_2011) plus the few blocks under
# JMX_FRAMEWORK_2011_01. The libraries are built a third time with GLOBAL_DEFS into
# build\obj\global and build\lib\global (GLOBAL_LIBS); everything linked with them is compiled
# with GLOBAL_DEFS too (the exe has the single module string "GlobalManager").
GLOBAL_DEFS = /DJMX_FRAMEWORK_2011 /DJMX_FRAMEWORK_2011_01 \
              /DSERVER_MODULE_NAME=\"GlobalManager\" \
              /DSERVER_CONFIG_MODULE_NAME=\"GlobalManager\"
GLOBAL_OBJ = $(OBJ)\global
GLOBAL_LIBDIR = $(LIBDIR)\global
GLOBAL_BSLIB_OBJS = $(BSLIB_OBJS:build\obj\BSLib=build\obj\global\BSLib)
GLOBAL_BSNET_OBJS = $(BSNET_OBJS:build\obj\BSNet=build\obj\global\BSNet)
GLOBAL_SRVFW_OBJS = $(SRVFW_OBJS:build\obj\ServerFramework=build\obj\global\ServerFramework)
GLOBAL_LIBS = $(GLOBAL_LIBDIR)\ServerFramework.lib $(GLOBAL_LIBDIR)\BSNet.lib \
              $(GLOBAL_LIBDIR)\BSLib.lib

# The August 2011 framework of SR_ShardManager (JMX_ServerFramework\FRAMEWORK_2011.md, "August 2011
# (SR_ShardManager)"): the July 2011 framework with the January 2011 DB layer (JMX_FRAMEWORK_2011,
# JMX_FRAMEWORK_2011_01) plus the blocks under JMX_FRAMEWORK_2011_08. The libraries are built a
# fourth time with SHARD_DEFS into build\obj\shard and build\lib\shard (SHARD_LIBS); everything
# linked with them is compiled with SHARD_DEFS too (the exe has the single module string
# "SR_ShardManager").
SHARD_DEFS = /DJMX_FRAMEWORK_2011 /DJMX_FRAMEWORK_2011_01 /DJMX_FRAMEWORK_2011_08 \
             /DSERVER_MODULE_NAME=\"SR_ShardManager\" \
             /DSERVER_CONFIG_MODULE_NAME=\"SR_ShardManager\"
SHARD_OBJ = $(OBJ)\shard
SHARD_LIBDIR = $(LIBDIR)\shard
SHARD_BSLIB_OBJS = $(BSLIB_OBJS:build\obj\BSLib=build\obj\shard\BSLib)
SHARD_BSNET_OBJS = $(BSNET_OBJS:build\obj\BSNet=build\obj\shard\BSNet)
SHARD_SRVFW_OBJS = $(SRVFW_OBJS:build\obj\ServerFramework=build\obj\shard\ServerFramework)
SHARD_LIBS = $(SHARD_LIBDIR)\ServerFramework.lib $(SHARD_LIBDIR)\BSNet.lib \
             $(SHARD_LIBDIR)\BSLib.lib

# SR_ShardManager application (SilkroadOnline\Server, the original D:\WORK2005\Source\SilkroadOnline\
# Server tree), compiled with SHARD_DEFS and linked with SHARD_LIBS. SHARD_REC_OBJS: the reference
# record classes of ServerCommon.
SHARD_APP_INC = /ISilkroadOnline\Server
SHARD_REC_OBJS = $(OBJ)\ServerCommon\RefRecords.obj
# SHARD_INST_OBJS: the instance record classes (they need ReferenceData_FindRefObj of the
# reference data).
SHARD_INST_OBJS = $(OBJ)\ServerCommon\InstanceRecords.obj
# SHARD_REFDATA_OBJS: the reference data (CReferenceData, the table builders and row readers).
# Needs SHARD_REC_OBJS (the siege rows are the data parts of the record classes).
SHARD_REFDATA_OBJS = $(OBJ)\ServerCommon\ReferenceData.obj \
	$(OBJ)\ServerCommon\RefDataQuest.obj \
	$(OBJ)\ServerCommon\RefDataObj.obj \
	$(OBJ)\ServerCommon\RefDataDrop.obj \
	$(OBJ)\ServerCommon\RefDataTeleport.obj \
	$(OBJ)\ServerCommon\RefDataShop.obj \
	$(OBJ)\ServerCommon\RefDataMisc.obj \
	$(OBJ)\ServerCommon\RefDataGacha.obj

# GlobalManager application (JMX_CommonServers\GlobalManager), compiled with GLOBAL_DEFS.
# GlobalManager.exe ("nmake global") is GLOBAL_APP_OBJS + GLOBAL_MAIN_OBJS + WinMain +
# GLOBAL_EXE_OBJS; the tests link the parts they need with their own stand-ins.
GLOBAL_OBJS = \
	$(OBJ)\GlobalManager\ContentUser.obj \
	$(OBJ)\GlobalManager\GlobalManagerJobs.obj \
	$(OBJ)\GlobalManager\GlobalManagerDB.obj

# The service manager part (CServiceManagerProcess). Its SM log members and overlap jobs are in
# GLOBAL_JOB_OBJS; GlobalManagerSvcTest links it with stand-ins for them instead. The exe needs
# GLOBAL_SVC_OBJS and GLOBAL_JOB_OBJS.
GLOBAL_SVC_OBJS = \
	$(OBJ)\GlobalManager\ServiceManagerProcess.obj \
	$(OBJ)\GlobalManager\ServiceManagerControl.obj \
	$(OBJ)\GlobalManager\ServiceManagerAccount.obj \
	$(OBJ)\GlobalManager\ServiceManagerPatch.obj

# The overlap jobs of the service manager and the SMC log (the functions of GlobalManagerSvcFwd.h).
# They call the punishment manager and are not linked into GlobalManagerSvcTest (which has
# stand-ins); GlobalManagerJobsTest links them with GLOBAL_SVC_OBJS. The exe needs both.
GLOBAL_JOB_OBJS = \
	$(OBJ)\GlobalManager\ServiceManagerJobs.obj \
	$(OBJ)\GlobalManager\ServiceManagerLog.obj

# The punishment manager, the user validation history, billing, the slave process with the IP
# country table and the CAS chat manager. The jobs tests link stand-ins for the punishment
# manager instead; the exe needs these objects with GLOBAL_OBJS, GLOBAL_SVC_OBJS and
# GLOBAL_JOB_OBJS (GLOBAL_EXE_OBJS).
GLOBAL_BILL_OBJS = \
	$(OBJ)\GlobalManager\PunishmentManager.obj \
